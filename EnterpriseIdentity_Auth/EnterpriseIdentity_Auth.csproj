    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="Volo.Abp.Core" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
